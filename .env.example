# Gemini API (Bangla TTS + hold-to-speak EN→BN translate). Prefer server-side.
# Copy to `.env.local` and restart `npm run dev` after changing it.
# Used by Vite /api/tts + /api/translate middleware (dev/preview) and Vercel api/*.js (production).
# If unset, parents can paste a key in Settings (stored only on that device).
GEMINI_API_KEY=
